CREATE FUNCTION dbo.fx_get_membership_values
(
    @membershipKey varchar(50)
)
RETURNS @membershipValues TABLE
(
    membership_value varchar(256)
)
AS
BEGIN

    IF @membershipKey = 'key1'
    BEGIN
        INSERT INTO @membershipValues
        SELECT CAST(value_column AS varchar(256))
        FROM dbo.membership_table_1;
    END

    ELSE IF @membershipKey = 'key2'
    BEGIN
        INSERT INTO @membershipValues
        SELECT CAST(value_column AS varchar(256))
        FROM dbo.membership_table_2;
    END

    ELSE IF @membershipKey = 'key3'
    BEGIN
        INSERT INTO @membershipValues
        SELECT CAST(value_column AS varchar(256))
        FROM dbo.membership_table_3;
    END

    ELSE IF @membershipKey = 'key4'
    BEGIN
        INSERT INTO @membershipValues
        SELECT CAST(value_column AS varchar(256))
        FROM dbo.membership_table_4;
    END

    RETURN;
END;