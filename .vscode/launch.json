{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Listen for Xdebug - Apache",
      "type": "php",
      "request": "launch",
      "port": 9003
    },
    {
      "name": "Run current PHP script",
      "type": "php",
      "request": "launch",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "port": 9003,
      "runtimeArgs": [
        "-dxdebug.mode=debug",
        "-xdebug.start_with_request=yes"
      ],
      "env": {
        "LA_CONFIG": "/var/www/html/liberanalytics/config/",
        "LA_CONFIG_FILE": "/var/www/html/liberanalytics/config/la_config_dev.json"
      }
    },
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    }
  ]
}
