# VS Code project config
.vscode/*
!.vscode/launch.json
!.vscode/settings.json

# Environment config files
/config/*.json

# DB connection/config files
/config/*.config

# Keep the .gitkeep.
!/config/.gitkeep

# Third-party dependency code downloaded by Composer
/vendor/

# Python
.venv/
__pycache__/
*__pycache__*/
*.py[cod]

# Ad hoc/generated developer files
*codetohtml*
*liber_enhance*
*gitdiff*
*test*

# Logs
*.log

# Generated/exported site assets
site/assets/

# Favicons
site/apple-touch-icon.png
site/favicon-16x16.png
site/favicon-32x32.png
site/favicon.ico
site/favicon.svg

# Site calibration checks
site/envcheck.php